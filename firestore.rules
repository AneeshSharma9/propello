rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users can update their own profile; read is allowed for signed-in users
    // so the app can check username availability at signup.
    match /users/{uid} {
      allow read: if signedIn();
      allow update: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if signedIn();
    }

    // Service listings are publicly browseable; only signed-in users create/edit/delete
    match /services/{listing} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // Requests are managed by signed-in users
    match /requests/{requestId} {
      allow read, create, update, delete: if signedIn();
    }

    // Chat messages: only signed-in users may talk
    match /chats/{message} {
      allow read, create: if signedIn() && request.auth.uid != null;
      allow delete: if signedIn();
    }

    // Ratings are public for browsing; only signed-in users submit them
    match /ratings/{rating} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }
  }
}